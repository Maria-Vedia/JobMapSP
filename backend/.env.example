# Puerto del servidor Express
PORT=4000

# Origen permitido por CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# --- MySQL ---
# Si DB_HOST, DB_USER o DB_NAME están vacíos, la API funciona sin base de datos
# (devuelve listas vacías). Nunca subas el archivo .env con credenciales reales.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=jobmap_sp
